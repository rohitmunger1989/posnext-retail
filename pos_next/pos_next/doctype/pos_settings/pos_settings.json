   "fieldname": "default_loyalty_program",
   "fieldtype": "Link",
   "label": "Loyalty Program",
   "mandatory_depends_on": "enable_loyalty_program",
   "options": "Loyalty Program"
  },
  {
   "depends_on": "enable_loyalty_program",
