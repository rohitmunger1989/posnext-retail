  {
   "fieldname": "pos_profile",
   "fieldtype": "Link",
   "in_list_view": 1,
   "label": "POS Profile",
   "options": "POS Profile",
   "reqd": 1,
   "unique": 1
  },
  {
   "default": "1",
   "description": "Enable custom POS settings for this profile",
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "Enabled"
  },
  {
   "fieldname": "section_break_localization",
   "fieldtype": "Section Break",
   "label": "Localization"
