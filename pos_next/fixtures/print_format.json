  "html": "<style>\r\n\t@page { size: 80mm auto; margin: 0; }\r\n\r\n\tbody {\r\n\t\tfont-family: 'DejaVu Sans', 'Arial', sans-serif;\r\n\t\twidth: 80mm;\r\n\t\tmax-width: 80mm;\r\n\t\tmargin: 0 auto;\r\n\t\tpadding: 8px;\r\n\t\tfont-size: 11px;\r\n\t\tline-height: 1.35;\r\n\t}\r\n\r\n\t.receipt {\r\n\t\twidth: 100%;\r\n\t\tdirection: ltr;\r\n\t\tcolor: #111827;\r\n\t}\r\n\r\n\t.text-center { text-align: center; }\r\n\r\n\t.brand-title {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tletter-spacing: 0.5px;\r\n\t}\r\n\r\n\t.brand-subtitle {\r\n\t\tfont-size: 10px;\r\n\t\tmargin-top: 3px;\r\n\t\tcolor: #4b5563;\r\n\t}\r\n\r\n\t.section {\r\n\t\tmargin-top: 10px;\r\n\t\tborder-top: 1px dashed #1f2937;\r\n\t\tpadding-top: 8px;\r\n\t}\r\n\r\n\t.section-title {\r\n\t\tfont-size: 11px;\r\n\t\tfont-weight: 700;\r\n\t\ttext-transform: uppercase;\r\n\t\tmargin-bottom: 5px;\r\n\t\tletter-spacing: 0.2px;\r\n\t}\r\n\r\n\t.eod-row,\r\n\t.row {\r\n\t\tdirection: ltr;\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\tgap: 8px;\r\n\t\tmargin: 2px 0;\r\n\t}\r\n\r\n\t.label { color: #374151; }\r\n\r\n\t.value {\r\n\t\ttext-align: right;\r\n\t\tfont-weight: 600;\r\n\t}\r\n\r\n\t.muted {\r\n\t\tcolor: #6b7280;\r\n\t\tfont-size: 10px;\r\n\t}\r\n\r\n\t.emphasis {\r\n\t\tfont-size: 13px;\r\n\t\tfont-weight: 800;\r\n\t\tborder-top: 1px solid #111827;\r\n\t\tpadding-top: 5px;\r\n\t\tmargin-top: 5px;\r\n\t}\r\n\r\n\t.sub-emphasis {\r\n\t\tfont-weight: 700;\r\n\t\tborder-top: 1px dotted #9ca3af;\r\n\t\tpadding-top: 3px;\r\n\t\tmargin-top: 3px;\r\n\t}\r\n\r\n\t.item-block {\r\n\t\tpadding: 6px 0;\r\n\t\tborder-bottom: 1px dotted #d1d5db;\r\n\t}\r\n\r\n\t.item-title {\r\n\t\tfont-size: 11px;\r\n\t\tfont-weight: 700;\r\n\t\tmargin-bottom: 2px;\r\n\t}\r\n\r\n\t.item-meta {\r\n\t\tdisplay: flex;\r\n\t\tjustify-content: space-between;\r\n\t\tfont-size: 10px;\r\n\t\tcolor: #4b5563;\r\n\t}\r\n\r\n\t.pay-block {\r\n\t\tmargin-bottom: 7px;\r\n\t\tpadding-bottom: 6px;\r\n\t\tborder-bottom: 1px dotted #d1d5db;\r\n\t}\r\n\r\n\t.payment-name {\r\n\t\tfont-size: 11px;\r\n\t\tfont-weight: 800;\r\n\t\tmargin-bottom: 3px;\r\n\t}\r\n\r\n\t.short-tag {\r\n\t\tcolor: #b91c1c;\r\n\t\tfont-weight: 700;\r\n\t}\r\n\r\n\t.over-tag {\r\n\t\tcolor: #166534;\r\n\t\tfont-weight: 700;\r\n\t}\r\n\r\n\t.balanced-tag {\r\n\t\tcolor: #166534;\r\n\t\tfont-weight: 700;\r\n\t}\r\n\r\n\t.summary-box {\r\n\t\tborder: 1px solid #111827;\r\n\t\tborder-radius: 3px;\r\n\t\tpadding: 6px;\r\n\t\tmargin-top: 6px;\r\n\t}\r\n\r\n\t.footer {\r\n\t\tmargin-top: 12px;\r\n\t\tborder-top: 1px dashed #1f2937;\r\n\t\tpadding-top: 8px;\r\n\t\ttext-align: center;\r\n\t\tfont-size: 9px;\r\n\t\tcolor: #4b5563;\r\n\t}\r\n</style>\r\n\r\n{%- set items_sold = get_items_sold(doc) -%}\r\n{%- set taxes = doc.taxes or [] -%}\r\n{%- set payments = doc.payment_reconciliation or [] -%}\r\n\r\n{%- set tax_total = taxes | sum(attribute='amount') -%}\r\n{%- set total_expected = payments | sum(attribute='expected_amount') -%}\r\n{%- set total_counted = payments | sum(attribute='closing_amount') -%}\r\n{%- set summary_diff = total_counted - total_expected -%}\r\n\r\n{%- set profile_address = frappe.db.get_value('POS Profile', doc.pos_profile, 'company_address') -%}\n{%- set address_doc = frappe.get_doc('Address', profile_address) if profile_address else None -%}\r\n\r\n<div class=\"receipt\">\r\n\r\n\t<div class=\"text-center brand-title\">\r\n\t\tEND-OF-DAY REPORT\r\n\t</div>\r\n\r\n\t<div class=\"text-center brand-subtitle\">\r\n\t\t{{ doc.company or 'POS Next' }}\r\n\t</div>\r\n\r\n\t{%- if address_doc -%}\n<div class=\"text-center brand-subtitle\">\n\t{{ address_doc.address_line1 or '' }}\n\t{%- if address_doc.address_line2 %}, {{ address_doc.address_line2 }}{% endif -%}\n\t{%- if address_doc.city %}, {{ address_doc.city }}{% endif -%}\n</div>\n{%- endif -%}\r\n\r\n\r\n\t<!-- SESSION -->\r\n\t<div class=\"section\">\r\n\t\t<div class=\"section-title\">Session</div>\r\n\r\n\t\t<div class=\"eod-row\">\r\n\t\t\t<span class=\"label\">Profile</span>\r\n\t\t\t<span class=\"value\">{{ doc.pos_profile }}</span>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"eod-row\">\r\n\t\t\t<span class=\"label\">Cashier</span>\r\n\t\t\t<span class=\"value\">{{ doc.user }}</span>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"eod-row\">\r\n\t\t\t<span class=\"label\">Opened</span>\r\n\t\t\t<span class=\"value\">{{ doc.period_start_date }}</span>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"eod-row\">\r\n\t\t\t<span class=\"label\">Closed</span>\r\n\t\t\t<span class=\"value\">{{ doc.period_end_date }}</span>\r\n\t\t</div>\r\n\r\n\t\t<div class=\"eod-row\">\r\n\t\t\t<span class=\"label\">Closing Shift</span>\r\n\t\t\t<span class=\"value\">{{ doc.name }}</span>\r\n\t\t</div>\r\n\t</div>\r\n\r\n\r\n\t<!-- SALES SUMMARY -->\n\t<div class=\"section\">\n\t\t<div class=\"section-title\">Sales Summary</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Sales Invoices</span>\n\t\t\t<span class=\"value\">{{ doc.sales_count or 0 }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Return Invoices</span>\n\t\t\t<span class=\"value\">{{ doc.returns_count or 0 }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Gross Sales</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.sales_total or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Returns</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.returns_total or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row emphasis\">\n\t\t\t<span class=\"label\">Net Sales</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.grand_total or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\" style=\"margin-top:6px;\">\n\t\t\t<span class=\"label\">Sold Qty</span>\n\t\t\t<span class=\"value\">{{ '%.2f' | format(doc.sales_quantity or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Return Qty</span>\n\t\t\t<span class=\"value\">{{ '%.2f' | format(doc.returns_quantity or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row sub-emphasis\">\n\t\t\t<span class=\"label\">Net Qty</span>\n\t\t\t<span class=\"value\">{{ '%.2f' | format(doc.total_quantity or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Customer Credit Used</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.customer_credit_redeemed or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Customer Credit Issued</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.customer_credit_issued or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">On Account</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.outstanding_total or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Net Before Tax</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(doc.net_total or 0) }}</span>\n\t\t</div>\n\n\t\t<div class=\"eod-row\">\n\t\t\t<span class=\"label\">Tax</span>\n\t\t\t<span class=\"value\">{{ '%.3f' | format(tax_total or 0) }}</span>\n\t\t</div>\n\t</div>\n\n\n\t<!-- PAYMENT METHOD SUMMARY -->\n\t<div class=\"section\">\n\t\t<div class=\"section-title\">Payment Method Summary</div>\n\n\t\t{%- if payments -%}\n\n\t\t\t{%- for payment in payments -%}\n\n\t\t\t\t{%- set payment_name = (payment.mode_of_payment or '') | lower -%}\n\t\t\t\t{%- set movement = (payment.expected_amount or 0) - (payment.opening_amount or 0) -%}\n\n\t\t\t\t<div class=\"pay-block\">\n\n\t\t\t\t\t<div class=\"payment-name\">\n\t\t\t\t\t\t{{ payment.mode_of_payment }}\n\t\t\t\t\t</div>\n\n\t\t\t\t\t{%- if payment_name == 'cash' -%}\n\n\t\t\t\t\t\t<div class=\"eod-row\">\n\t\t\t\t\t\t\t<span class=\"label\">Opening</span>\n\t\t\t\t\t\t\t<span class=\"value\">{{ '%.3f' | format(payment.opening_amount or 0) }}</span>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"eod-row\">\n\t\t\t\t\t\t\t<span class=\"label\">Net Cash Sales</span>\n\t\t\t\t\t\t\t<span class=\"value\">{{ '%.3f' | format(movement or 0) }}</span>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t\t<div class=\"eod-row sub-emphasis\">\n\t\t\t\t\t\t\t<span class=\"label\">Expected</span>\n\t\t\t\t\t\t\t<span class=\"value\">{{ '%.3f' | format(payment.expected_amount or 0) }}</span>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t{%- elif 'wallet' in payment_name or 'loyalty' in payment_name -%}\n\n\t\t\t\t\t\t<div class=\"eod-row\">\n\t\t\t\t\t\t\t<span class=\"label\">Used</span>\n\t\t\t\t\t\t\t<span class=\"value\">{{ '%.3f' | format(movement or 0) }}</span>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t{%- else -%}\n\n\t\t\t\t\t\t<div class=\"eod-row\">\n\t\t\t\t\t\t\t<span class=\"label\">Collected</span>\n\t\t\t\t\t\t\t<span class=\"value\">{{ '%.3f' | format(movement or 0) }}</span>\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t{%- endif -%}\n\n\t\t\t\t</div>\n\n\t\t\t{%- endfor -%}\n\n\t\t{%- else -%}\n\n\t\t\t<div class=\"muted\">No payment rows</div>\n\n\t\t{%- endif -%}\n\n\t\t<div class=\"pay-block\">\n\t\t\t<div class=\"payment-name\">Customer Credit</div>\n\n\t\t\t<div class=\"eod-row\">\n\t\t\t\t<span class=\"label\">Used</span>\n\t\t\t\t<span class=\"value\">\n\t\t\t\t\t{{ '%.3f' | format(doc.customer_credit_redeemed or 0) }}\n\t\t\t\t</span>\n\t\t\t</div>\n\t\t</div>\n\n\t</div>\n\n\n\t<!-- ITEMS SOLD -->\r\n\t<div class=\"section\">\r\n\t\t<div class=\"section-title\">Items Sold</div>\r\n\r\n\t\t{%- if items_sold -%}\r\n\r\n\t\t\t{%- for item in items_sold -%}\r\n\r\n\t\t\t\t<div class=\"item-block\">\r\n\r\n\t\t\t\t\t<div class=\"item-title\">\r\n\t\t\t\t\t\t{{ item.item_name or item.item_code }}\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"item-meta\">\r\n\t\t\t\t\t\t<span>\r\n\t\t\t\t\t\t\tQty: {{ '%.2f' | format(item.qty or 0) }}\r\n\t\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t\t<span>\r\n\t\t\t\t\t\t\t{{ '%.3f' | format(item.amount or 0) }}\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t</div>\r\n\r\n\t\t\t{%- endfor -%}\r\n\r\n\t\t{%- else -%}\r\n\r\n\t\t\t<div class=\"muted\">\r\n\t\t\t\tNo item rows found\r\n\t\t\t</div>\r\n\r\n\t\t{%- endif -%}\r\n\t</div>\r\n\r\n\r\n\t<!-- TAX -->\r\n\t<div class=\"section\">\r\n\t\t<div class=\"section-title\">Taxes</div>\r\n\r\n\t\t{%- if taxes -%}\r\n\r\n\t\t\t{%- for tax in taxes -%}\r\n\r\n\t\t\t\t<div class=\"eod-row\">\r\n\r\n\t\t\t\t\t<span class=\"label\">\r\n\t\t\t\t\t\t{{ tax.account_head }}\r\n\t\t\t\t\t\t({{ '%.2f' | format(tax.rate or 0) }}%)\r\n\t\t\t\t\t</span>\r\n\r\n\t\t\t\t\t<span class=\"value\">\r\n\t\t\t\t\t\t{{ '%.3f' | format(tax.amount or 0) }}\r\n\t\t\t\t\t</span>\r\n\r\n\t\t\t\t</div>\r\n\r\n\t\t\t{%- endfor -%}\r\n\r\n\t\t{%- else -%}\r\n\r\n\t\t\t<div class=\"muted\">\r\n\t\t\t\tNo tax rows\r\n\t\t\t</div>\r\n\r\n\t\t{%- endif -%}\r\n\t</div>\r\n\r\n\r\n\t<!-- PAYMENT RECONCILIATION -->\r\n\t<div class=\"section\">\r\n\t\t<div class=\"section-title\">Payment Reconciliation</div>\r\n\r\n\t\t{%- if payments -%}\r\n\r\n\t\t\t{%- for payment in payments -%}\r\n\r\n\t\t\t\t<div class=\"pay-block\">\r\n\r\n\t\t\t\t\t<div class=\"payment-name\">\r\n\t\t\t\t\t\t{{ payment.mode_of_payment }}\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"eod-row\">\r\n\t\t\t\t\t\t<span class=\"label\">Opening</span>\r\n\t\t\t\t\t\t<span class=\"value\">\r\n\t\t\t\t\t\t\t{{ '%.3f' | format(payment.opening_amount or 0) }}\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"eod-row\">\r\n\t\t\t\t\t\t<span class=\"label\">Expected</span>\r\n\t\t\t\t\t\t<span class=\"value\">\r\n\t\t\t\t\t\t\t{{ '%.3f' | format(payment.expected_amount or 0) }}\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"eod-row\">\r\n\t\t\t\t\t\t<span class=\"label\">Counted</span>\r\n\t\t\t\t\t\t<span class=\"value\">\r\n\t\t\t\t\t\t\t{{ '%.3f' | format(payment.closing_amount or 0) }}\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<div class=\"eod-row\">\r\n\t\t\t\t\t\t<span class=\"label\">Difference</span>\r\n\r\n\t\t\t\t\t\t<span class=\"value\">\r\n\r\n\t\t\t\t\t\t\t{{ '%.3f' | format(payment.difference or 0) }}\r\n\r\n\t\t\t\t\t\t\t{%- if (payment.difference or 0) < 0 -%}\r\n\t\t\t\t\t\t\t\t<span class=\"short-tag\"> SHORT</span>\r\n\r\n\t\t\t\t\t\t\t{%- elif (payment.difference or 0) > 0 -%}\r\n\t\t\t\t\t\t\t\t<span class=\"over-tag\"> OVER</span>\r\n\r\n\t\t\t\t\t\t\t{%- else -%}\r\n\t\t\t\t\t\t\t\t<span class=\"balanced-tag\"> BALANCED</span>\r\n\t\t\t\t\t\t\t{%- endif -%}\r\n\r\n\t\t\t\t\t\t</span>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t</div>\r\n\r\n\t\t\t{%- endfor -%}\r\n\r\n\t\t{%- else -%}\r\n\r\n\t\t\t<div class=\"muted\">\r\n\t\t\t\tNo payment rows\r\n\t\t\t</div>\r\n\r\n\t\t{%- endif -%}\r\n\t</div>\r\n\r\n\r\n\t<!-- FINAL SUMMARY -->\r\n\t<div class=\"section\">\r\n\t\t<div class=\"section-title\">Final Summary</div>\r\n\r\n\t\t<div class=\"summary-box\">\r\n\r\n\t\t\t<div class=\"eod-row\">\r\n\t\t\t\t<span class=\"label\">Total Expected</span>\r\n\t\t\t\t<span class=\"value\">\r\n\t\t\t\t\t{{ '%.3f' | format(total_expected or 0) }}\r\n\t\t\t\t</span>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"eod-row\">\r\n\t\t\t\t<span class=\"label\">Total Counted</span>\r\n\t\t\t\t<span class=\"value\">\r\n\t\t\t\t\t{{ '%.3f' | format(total_counted or 0) }}\r\n\t\t\t\t</span>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"eod-row emphasis\">\r\n\t\t\t\t<span class=\"label\">Net Variance</span>\r\n\r\n\t\t\t\t<span class=\"value\">\r\n\r\n\t\t\t\t\t{{ '%.3f' | format(summary_diff or 0) }}\r\n\r\n\t\t\t\t\t{%- if summary_diff < 0 -%}\r\n\t\t\t\t\t\t<span class=\"short-tag\"> SHORT</span>\r\n\r\n\t\t\t\t\t{%- elif summary_diff > 0 -%}\r\n\t\t\t\t\t\t<span class=\"over-tag\"> OVER</span>\r\n\r\n\t\t\t\t\t{%- else -%}\r\n\t\t\t\t\t\t<span class=\"balanced-tag\"> BALANCED</span>\r\n\t\t\t\t\t{%- endif -%}\r\n\r\n\t\t\t\t</span>\r\n\t\t\t</div>\r\n\r\n\t\t</div>\r\n\t</div>\r\n\r\n\r\n\t<div class=\"footer\">\r\n\t\t<div>\r\n\t\t\tPrinted at {{ frappe.utils.now_datetime() }}\r\n\t\t</div>\r\n\r\n\t\t<div>\r\n\t\t\tPrinted by {{ frappe.session.user }}\r\n\t\t</div>\r\n\r\n\t\t<div>POS Next</div>\r\n\t</div>\r\n\r\n</div>",
